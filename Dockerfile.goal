# Goal-session build: reuse the perf-final toolchain layer (the local/rocm-base:10.0.0
# base was pruned); wipe the tree, copy fresh sources, rebuild the HIP extension.
# NOTE: the venv in the perf-final lineage is /opt/rocm-venv (NOT /opt/venv), and python3
# resolves there too — an install into any other prefix is silently ignored, and a failed
# pip masked by a pipe gives you a stale-binary image that still benchmarks.
FROM exllamav3-rocm:perf-final
SHELL ["/bin/bash", "-c"]

WORKDIR /opt/exllamav3
RUN rm -rf /opt/exllamav3
COPY . /opt/exllamav3
ARG EXL3_CUMODE=0
# pip's pyproject backend does not forward setup.py stdout into pip.log, so the
# compile-flag stamp is /tmp/exl3_hip_cflags.txt (written by setup.py). The
# real CU-mode proof is the ELF .workgroup_processor_mode gate below.
RUN EXL3_CUMODE=${EXL3_CUMODE} EXLLAMA_VERBOSE=1 PYTORCH_ROCM_ARCH=gfx1100 MAX_JOBS=16 \
    /opt/rocm-venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation . > /tmp/pip.log 2>&1; \
    rc=$?; tail -80 /tmp/pip.log; \
    echo '--- hip cflags stamp ---'; cat /tmp/exl3_hip_cflags.txt 2>/dev/null || echo '(no stamp)'; \
    if [ "${EXL3_CUMODE}" = "1" ]; then \
      grep -E -- '-mcumode' /tmp/exl3_hip_cflags.txt || { echo 'EXL3_CUMODE=1 but /tmp/exl3_hip_cflags.txt has no -mcumode'; exit 1; }; \
    fi; \
    exit $rc
RUN python3 -c "import exllamav3.modules.attention_fn.bc_attn as b; assert b.bc_attn_enable is False, 'stale python copy!'" && \
    python3 -c "import torch, exllamav3_ext" && echo INSTALL_VERIFIED
# Real CU-mode gate: msgpack .workgroup_processor_mode in the fat .so (0x00=CU, 0x01=WGP).
# ninja does not echo hipcc argv, so the pip-log grep only proves setup.py recorded the flag.
ARG EXL3_CUMODE
RUN if [ "${EXL3_CUMODE}" = "1" ]; then \
      python3 /opt/exllamav3/profiling/check_so_wgp_mode.py \
        /opt/rocm-venv/lib/python3.12/site-packages/exllamav3_ext.cpython-312-x86_64-linux-gnu.so \
        --require cu; \
    fi

ENV EXL3_MODEL=/models/qwen38-27b
