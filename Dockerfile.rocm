FROM hipfire-rocm10:latest

# Base image ships ROCm 10.0 SDK (core/devel/libraries/device-gfx1100) at 10.0.0
# with headers under _rocm_sdk_devel/include/ and hipcc under _rocm_sdk_devel/bin/.
# /opt/rocm symlinks to _rocm_sdk_devel, so HIP_PATH/ROCM_PATH=/opt/rocm resolves
# both bin/hipcc and lib/llvm/bin/clang++ correctly.  Do NOT downgrade the SDK
# packages — the 7.14.x devel wheel strips headers and bin/.
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm-venv/bin:/opt/rocm/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/rocm-venv/lib/python3.12/site-packages/_rocm_sdk_core/lib:/opt/rocm-venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib:/opt/rocm-venv/lib/python3.12/site-packages/_rocm_sdk_libraries/lib
ENV CPLUS_INCLUDE_PATH=/opt/rocm-venv/lib/python3.12/site-packages/_rocm_sdk_core/include:/opt/rocm-venv/lib/python3.12/site-packages/_rocm_sdk_devel/include
ENV PYTORCH_ROCM_ARCH=gfx1100

# Python dev headers needed to compile the C++ extension (Python.h)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends python3-dev && rm -rf /var/lib/apt/lists/*

# torch ROCm wheel with --no-deps to avoid pulling rocm[device-all] (~2GB of
# unused GPU arches) or downgrading the base image's SDK packages.
RUN pip install --no-cache-dir --no-deps \
    --index-url https://download.pytorch.org/whl/rocm7.14 \
    torch==2.14.0+rocm7.14 && \
    pip install --no-cache-dir \
    filelock typing-extensions sympy networkx jinja2 fsspec setuptools && \
    pip install --no-cache-dir \
    ninja fastapi uvicorn tokenizers numpy rich typing_extensions \
    safetensors pillow pyyaml marisa_trie pydantic llguidance triton

WORKDIR /opt/exllamav3
COPY . /opt/exllamav3
# Non-editable install forces setup.py to build the C++/HIP extension at build
# time (editable mode skips it).  --no-build-isolation uses the already-installed
# ROCm torch so setup.py detects it and includes ext_modules; --no-deps prevents
# pip from pulling the CUDA torch wheel over the ROCm one.
RUN EXLLAMA_VERBOSE=1 pip install --no-cache-dir --no-deps --no-build-isolation . 2>&1 | tail -30

ENV EXL3_MODEL=/models/model
ENV PORT=9001
EXPOSE 9001
ENTRYPOINT []
CMD ["python3", "/opt/exllamav3/serve.py"]
