# Perf/gate image: the DEPLOYED tabbyapi-rocm:serve (tuned ext, Sep 16) + patched
# sources, extension recompiled in place. Do NOT build from exllamav3-rocm:serve --
# that base predates the msq/sq tuning (ext .so from Sep 14) and measures ~half decode.
#
# The repo's stale build/ dir must NOT reach the image: a Sep-14 build/ tree made
# setuptools consider the ext "current", pip silently skipped installing a fresh .so,
# and RUN ... | tail swallowed the error - the image kept the base's .so while
# appearing to rebuild (every perf image from 2026-09-16 evening measured the base).
FROM tabbyapi-rocm:serve
ENV PYTORCH_ROCM_ARCH=gfx1100 EXLLAMA_VERBOSE=1 MAX_JOBS=8
WORKDIR /opt/exllamav3
COPY . /opt/exllamav3
# Build, keeping the full pip log in-image for post-mortem; fail loudly on error
RUN rm -rf build exllamav3.egg-info && \
    pip install --no-cache-dir --no-deps --no-build-isolation . > /tmp/pip_install.log 2>&1; \
    RC=$?; tail -20 /tmp/pip_install.log; [ $RC -eq 0 ] || (echo "PIP FAILED rc=$RC"; exit 1)
# Verify the installed .so actually contains the patched route (fails the build otherwise)
RUN SO=$(find /opt/rocm-venv -name "exllamav3_ext*.so" | head -1) && \
    echo "installed ext: $SO" && \
    CNT=$(strings "$SO" | grep -c "msq-launch") && \
    echo "msq-launch marker count: $CNT" && \
    [ "$CNT" -gt 0 ] || (echo "EXTENSION DOES NOT CONTAIN PATCHED ROUTE"; exit 1)
